@model KanbanTaskManagement.ViewModels.KanbanColumnViewModel
@{
    var column = Model.Column;
    var today = DateTime.UtcNow.Date;
}

<style>
    .task-card {
        border: none;
        border-left: 5px solid transparent;
        background-color: #2c3034;
        color: #e9ecef;
        transition: 0.2s;
        cursor: pointer;
    }

        .task-card:hover {
            background-color: #343a40;
        }

    .priority-HIGH {
        border-left-color: #dc3545;
    }

    .priority-MEDIUM {
        border-left-color: #ffc107;
    }

    .priority-LOW {
        border-left-color: #28a745;
    }

    .user-badge {
        width: 25px;
        height: 25px;
        background-color: #495057;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: bold;
        border: 1px solid #6c757d;
    }

    .due-badge {
        font-size: 0.72rem;
    }

    .due-overdue {
        background-color: #dc3545 !important;
    }

    .task-move .btn {
        line-height: 1;
        padding: 0.1rem 0.4rem;
    }
</style>

<div class="card bg-dark border-secondary h-100">
    <div class="card-header border-0 text-white" style="background-color: @Model.HeaderColor;">
        <h5 class="mb-0 text-center fw-bold">@column.Type.ToString()</h5>
    </div>

    <div class="card-body p-2">
        @foreach (var task in column.Tasks)
        {
            var overdue = task.DueDate is { } due && task.CompletedAt is null && due.Date < today;
            <div class="task-card card mb-2 p-3 priority-@task.Priority"
                 data-bs-toggle="modal"
                 data-bs-target="#taskModal"
                 data-bs-id="@task.Id"
                 data-bs-name="@task.Name"
                 data-bs-desc="@task.Description"
                 data-bs-start="@(task.StartDate?.ToString("yyyy-MM-dd"))"
                 data-bs-due="@(task.DueDate?.ToString("yyyy-MM-dd"))"
                 data-bs-priority="@((int)task.Priority)"
                 data-bs-assigned="@string.Join(",", task.AssignedUsers)">

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong class="text-white">@task.Name</strong>
                    <i class="bi @(task.Priority == TaskPriority.HIGH ? "bi-exclamation-octagon-fill text-danger" :
                                     task.Priority == TaskPriority.MEDIUM ? "bi-exclamation-triangle-fill text-warning" :
                                     "bi-check-circle-fill text-success")"
                       title="Priorytet: @task.Priority.PolishName()"></i>
                </div>

                @if (task.DueDate is { } dueDate)
                {
                    <div class="mb-2">
                        <span class="badge due-badge @(overdue ? "due-overdue" : "bg-secondary")">
                            <i class="bi bi-calendar-event me-1"></i>@dueDate.ToString("dd.MM.yyyy")
                        </span>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-end">
                    <div class="d-flex gap-1">
                        @foreach (var user in task.AssignedUsers)
                        {
                            <div class="user-badge" title="@user">
                                @(!string.IsNullOrEmpty(user) ? user.Substring(0, 1).ToUpper() : "?")
                            </div>
                        }
                    </div>

                    @if (Model.CanEdit)
                    {
                        <div class="task-move d-flex gap-1" onclick="event.stopPropagation()">
                            @if (column.Type != ColumnType.BACKLOG)
                            {
                                <form asp-controller="Board" asp-action="MoveTask" method="post">
                                    <input type="hidden" name="boardId" value="@Model.BoardId" />
                                    <input type="hidden" name="taskId" value="@task.Id" />
                                    <input type="hidden" name="targetColumn" value="@((int)column.Type - 1)" />
                                    <button type="submit" class="btn btn-sm btn-outline-light"><i class="bi bi-arrow-left"></i></button>
                                </form>
                            }
                            @if (column.Type != ColumnType.DONE)
                            {
                                <form asp-controller="Board" asp-action="MoveTask" method="post">
                                    <input type="hidden" name="boardId" value="@Model.BoardId" />
                                    <input type="hidden" name="taskId" value="@task.Id" />
                                    <input type="hidden" name="targetColumn" value="@((int)column.Type + 1)" />
                                    <button type="submit" class="btn btn-sm btn-outline-light"><i class="bi bi-arrow-right"></i></button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (Model.CanEdit)
    {
        <div class="card-footer bg-transparent border-secondary">
            <form asp-controller="Board" asp-action="CreateTask" method="post" class="d-flex flex-wrap gap-2">
                <input type="hidden" name="boardId" value="@Model.BoardId" />
                <input type="hidden" name="columnType" value="@((int)column.Type)" />
                <input type="text" name="taskName" class="form-control form-control-sm bg-dark text-white border-secondary flex-grow-1"
                       placeholder="Nowe zadanie..." maxlength="120" required />
                <input type="date" name="dueDate" class="form-control form-control-sm bg-dark text-white border-secondary" style="max-width: 9rem;" title="Termin" />
                <select name="priority" class="form-select form-select-sm bg-dark text-white border-secondary" style="max-width: 7rem;" title="Priorytet">
                    @foreach (var p in RoleLabels.Priorities)
                    {
                        <option value="@((int)p)">@p.PolishName()</option>
                    }
                </select>
                <button type="submit" class="btn btn-sm btn-outline-info"><i class="bi bi-plus-lg"></i></button>
            </form>
        </div>
    }
</div>
