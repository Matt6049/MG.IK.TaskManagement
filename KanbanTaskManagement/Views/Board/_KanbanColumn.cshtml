@model KanbanTaskManagement.Models.Column

<style>
    /* Kolory nagłówków */
    .header-BACKLOG {
        background-color: #3b3b3b !important;
    }

    .header-IN_PROGRESS {
        background-color: #005f5f !important;
    }

    .header-DONE {
        background-color: #004d26 !important;
    }

    /* Styl karty zadania */
    .task-card {
        border: none;
        border-left: 5px solid transparent;
        background-color: #2c3034;
        color: #e9ecef;
        transition: 0.2s;
        cursor: pointer;
    }

        .task-card:hover {
            background-color: #343a40;
        }

    /* Pasek priorytetu */
    .priority-HIGH {
        border-left-color: #dc3545;
    }

    .priority-MEDIUM {
        border-left-color: #ffc107;
    }

    .priority-LOW {
        border-left-color: #28a745;
    }

    /* Inicjały użytkowników */
    .user-badge {
        width: 25px;
        height: 25px;
        background-color: #495057;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: bold;
        border: 1px solid #6c757d;
    }
</style>

<div class="card bg-dark border-secondary h-100">
    <div class="card-header border-0 text-white header-@Model.Type">
        <h5 class="mb-0 text-center fw-bold">@Model.Type.ToString()</h5>
    </div>

    <div class="card-body p-2">
        @foreach (var task in Model.Tasks)
        {
            <div class="task-card card mb-2 p-3 priority-@task.Priority"
                 data-bs-toggle="modal"
                 data-bs-target="#taskModal"
                 data-bs-id="@task.Id"
                 data-bs-name="@task.Name"
                 data-bs-desc="@task.Description">

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong class="text-white">@task.Name</strong>
                    <i class="bi @(task.Priority == TaskPriority.HIGH ? "bi-exclamation-octagon-fill text-danger" :
                                     task.Priority == TaskPriority.MEDIUM ? "bi-exclamation-triangle-fill text-warning" :
                                     "bi-check-circle-fill text-success")"></i>
                </div>

                <div class="mt-2 d-flex gap-1">
                    @foreach (var user in task.AssignedUsers)
                    {
                        <div class="user-badge" title="@user">
                            @(!string.IsNullOrEmpty(user) ? user.Substring(0, 1).ToUpper() : "?")
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>