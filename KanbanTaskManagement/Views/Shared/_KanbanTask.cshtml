@model KanbanTaskManagement.Models.KanbanTask

<div class="kanban-task">
	<div class="card-header">
		<h4>@Model.Name</h4>
		<span class="badge">@Model.Priority</span>
	</div>
	@if (!string.IsNullOrEmpty(Model.Description))
	{
		<p class="card-body">
			@Model.Description
		</p>
	}
	<div class="card-footer">
		<small>Created by <b>@Model.CreatorName</b> at <b>@Model.CreatedAt</b></small>
		@if (Model.AssignedUsers.Any())
		{
			<small>
				Assignees: @string.Join(", ", Model.AssignedUsers)
			</small>
		}
	</div>
</div>