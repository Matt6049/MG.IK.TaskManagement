<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KanbanTaskManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KanbanTaskManagement.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        .sidebar-link:hover {
            background-color: rgba(255, 255, 255, 0.15) !important;
            border-radius: 6px;
            color: #ffffff !important;
        }
          .sidebar-dropdown-toggle:hover {
                background-color: rgba(255, 255, 255, 0.1);
                border-radius: 6px;
           }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center fw-bold text-dark mb-0" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-layout-three-columns me-2" style="color: #008080; font-size: 1.4rem;"></i>
                    KanbanTaskManagement
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </nav>
    </header>

    <div class="d-flex">
        <div class="text-white border-end border-secondary"
             style="width: 250px; min-height: calc(100vh - 56px); flex-shrink: 0; background: linear-gradient(to top, #008080 50%, #000000 100%);">
            <div class="p-3">

                <div class="dropdown mb-4 border-bottom border-secondary pb-3">
                    <a href="#" class="d-flex align-items-center link-light text-decoration-none dropdown-toggle p-2 sidebar-dropdown-toggle" id="sidebarDropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle fs-1 me-3" style="color: #00adb5; vertical-align: middle;"></i>
                        <span class="fw-semibold fs-5 text-light">Jan Kowalski</span>
                    </a>
                    <ul class="dropdown-menu shadow" aria-labelledby="sidebarDropdownUser">
                        <li>
                        
                            <a class="dropdown-item" asp-controller="User" asp-action="Profile">
                                <i class="bi bi-person me-2"></i> Mój profil
                            </a>
                        
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#">Wyloguj się</a></li>
                    </ul>
                </div>
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item mb-1">
                        <a asp-controller="Dashboard" asp-action="Index" class="nav-link text-white sidebar-link">
                            <i class="bi bi-kanban me-2"></i> Tablice Kanban
                        </a>
                    </li>
                    <li class="nav-item mb-1">
                        <a asp-controller="Group" asp-action="Index" class="nav-link text-white sidebar-link">
                            <i class="bi bi-people me-2" style="color: #00adb5;"></i> Grupy
                        </a>
                    </li>
                </ul>
                <hr class="border-secondary">
                <div class="px-2 small text-muted">
                    Wersja aplikacji: 1.67
                </div>
            </div>
        </div>

        <div class="flex-grow-1 p-4" style="overflow-x: auto; background-color: #f8f9fa;">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>