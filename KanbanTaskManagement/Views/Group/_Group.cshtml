@model KanbanTaskManagement.ViewModels.GroupDTO
@{
string groupMembersId = "group-" + @Model.Id;
}


<div class="card mb-3 shadow-sm border-0 overflow-hidden group-item">
    <div class="card-header text-white border-0 pt-3 pb-3 group-header"
         style="cursor: pointer;"
         data-bs-toggle="collapse"
         data-bs-target="#@groupMembersId"
         aria-expanded="false">

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 group-name">
                    <i class="bi bi-people-fill me-2"></i>@Model.Name
                </h5>
                <small class="text-white-50">Utworzono: @Model.CreatedAt.ToString("dd.MM.yyyy")</small>
            </div>
            <i class="bi bi-chevron-down"></i>
        </div>
    </div>

    <div class="collapse" id="@groupMembersId">

    </div>
</div>

@section Scripts{
    <script>
        let lastResponseOk;
        async function loadMembers(){
            const container = document.getElementById("@groupMembersId");

            try{
                const response = await fetch(`/GroupController/GetGroupMembers?id=@Model.Id`);
                if(!response.ok) throw new Error(`Response status: ${response.status}`);

                const result = await response.text();
                container.innerHTML = result;
                document.removeEventListener("show.bs.collapse", loadMembers);
            } catch(e){
                console.error("Failed to load group members:", e);
                container.innerHTML("<p class='text-danger'>Ładowanie użytkowników nie powiodło się!</p>")
            }
        }

        document.addEventListener("show.bs.collapse", loadMembers)
    </script>
}