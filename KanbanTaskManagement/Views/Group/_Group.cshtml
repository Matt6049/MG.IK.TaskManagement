@model KanbanTaskManagement.ViewModels.GroupDTO
@{
string groupMembersId = "group-" + @Model.Id;
}


<div class="card mb-3 shadow-sm border-0 overflow-hidden group-item">
    <div class="card-header text-white border-0 pt-3 pb-3 group-header"
         style="cursor: pointer;"
         data-bs-toggle="collapse"
         data-bs-target="#@groupMembersId"
         aria-expanded="false">

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-0 group-name">
                    <i class="bi bi-people-fill me-2"></i>@Model.Name
                </h5>
                <small class="text-white-50">Utworzono: @Model.CreatedAt.ToString("dd.MM.yyyy")</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Calendar" asp-action="Index" asp-route-groupId="@Model.Id"
                   class="btn btn-sm btn-outline-light" onclick="event.stopPropagation()" title="Kalendarz grupy">
                    <i class="bi bi-calendar3"></i>
                </a>
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>
    </div>

    <div class="collapse" id="@groupMembersId" data-group-id="@Model.Id">

    </div>
</div>

