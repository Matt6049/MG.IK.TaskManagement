@model List<KanbanTaskManagement.Models.Group>
<style>
    .group-header {
        transition: background 0.4s ease-in-out;
        background: linear-gradient(to right, #008080 0%, #000000 100%);
    }

    .card:has(.collapse.show) .group-header {
        background: linear-gradient(to right, #008080 0%, #20b2aa 100%) !important;
    }
</style>

<div class="container-fluid p-4">
    <div class="row mb-4">
        <div class="col-md-9">
            <input type="text" id="groupSearch" class="form-control form-control-lg border-2"
                   placeholder="Wyszukaj grupę po nazwie..." onkeyup="filterGroups()">
        </div>
        <div class="col-md-3 text-md-end">
            <button class="btn btn-outline-secondary btn-lg w-100" onclick="collapseAll()">Zwiń wszystko</button>
        </div>
    </div>

    @foreach (var group in Model)
    {
        string collapseId = "group-" + group.Id;

        <div class="card mb-3 shadow-sm border-0 overflow-hidden group-item">
            <div class="card-header text-white border-0 pt-3 pb-3 group-header"
                 style="cursor: pointer;"
                 data-bs-toggle="collapse"
                 data-bs-target="#@collapseId"
                 aria-expanded="false">

                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0 group-name">
                            <i class="bi bi-people-fill me-2"></i>@group.Name
                        </h5>
                        <small class="text-white-50">Utworzono: @group.CreatedAt.ToString("dd.MM.yyyy")</small>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </div>
            </div>

            <div class="collapse" id="@collapseId">
                <div class="card-body p-0 border-top">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase small text-muted">
                            <tr>
                                <th class="ps-4">Użytkownik</th>
                                <th>Rola</th>
                                <th class="pe-4">Ostatnia aktywność</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in group.Members)
                            {
                                <tr>
                                    <td class="ps-4">@member.Username</td>
                                    <td><span class="badge" style="background-color: #008080;">@member.Role</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function collapseAll() {
            document.querySelectorAll('.collapse.show').forEach(function(el) {
                var bsCollapse = new bootstrap.Collapse(el);
                bsCollapse.hide();
            });
        }

        function filterGroups() {
            var input = document.getElementById('groupSearch').value.toLowerCase();
            var groups = document.querySelectorAll('.group-item');

            groups.forEach(function(group) {
                var name = group.querySelector('.group-name').innerText.toLowerCase();
                group.style.display = name.includes(input) ? "" : "none";
            });
        }
    </script>
}