@model IEnumerable<KanbanTaskManagement.ViewModels.GroupMemberDTO>

<div class="card-body p-0 border-top">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light text-uppercase small text-muted">
            <tr>
                <th class="ps-4">Użytkownik</th>
                <th>Rola</th>
                <th class="pe-4">Ostatnia aktywność</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model) {
                <tr>
                    <td class="ps-4">@member.Username.ToString()</td>
                    <td><span class="badge" style="background-color: #008080;">@member.Role</span></td>
                    <td class="pe-4">@member.LastActive</td>
                </tr>
            }
        </tbody>
    </table>
</div>
