@model KanbanTaskManagement.ViewModels.DashboardViewModel
@inject KanbanTaskManagement.Services.ICurrentUser CurrentUser

<style>
    .board-header {
        transition: filter 0.3s ease-in-out;
        color: white;
        text-decoration: none;
        display: block;
    }

        .board-header:hover {
            filter: brightness(1.15);
        }

    .viz-stacked-bar {
        display: flex;
        height: 22px;
        border-radius: 5px;
        overflow: hidden;
        background: #fff;
    }

    .viz-seg {
        margin-right: 2px;
        min-width: 3px;
        cursor: pointer;
        transition: filter .15s ease-in-out;
    }

        .viz-seg:last-child {
            margin-right: 0;
        }

        .viz-seg:hover, .viz-seg:focus-visible {
            filter: brightness(1.12);
            outline: none;
        }

    .viz-legend {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem 1.1rem;
        font-size: .82rem;
    }

    .viz-legend-item {
        display: flex;
        align-items: center;
        gap: .4rem;
    }

    .viz-swatch {
        width: 10px;
        height: 10px;
        border-radius: 2px;
        display: inline-block;
        flex-shrink: 0;
    }

    .viz-tooltip {
        position: fixed;
        background: #0b0b0b;
        color: #fff;
        padding: .35rem .6rem;
        border-radius: 6px;
        font-size: .8rem;
        pointer-events: none;
        z-index: 1000;
        white-space: nowrap;
    }
</style>

<div class="container-fluid p-4">
    @if (Model.TaskTotal > 0)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-baseline mb-2">
                    <h6 class="mb-0 text-secondary">Moje zadania — @Model.TaskTotal</h6>
                    <a asp-action="MyTasks" class="small text-decoration-none">Zobacz wszystkie</a>
                </div>
                <div class="viz-stacked-bar" role="img" aria-label="Rozkład Twoich zadań według terminu i statusu">
                    @foreach (var b in Model.TaskBuckets.Where(b => b.Count > 0))
                    {
                        <div class="viz-seg js-viz-seg" tabindex="0"
                             style="flex-grow:@b.Count; background-color:@b.Color;"
                             data-label="@b.Label" data-count="@b.Count"></div>
                    }
                </div>
                <div class="viz-legend mt-2">
                    @foreach (var b in Model.TaskBuckets.Where(b => b.Count > 0))
                    {
                        <span class="viz-legend-item">
                            <span class="viz-swatch" style="background-color:@b.Color;"></span>
                            @if (b.Icon is not null)
                            {
                                <i class="bi @b.Icon" style="color:@b.Color;"></i>
                            }
                            <span class="text-secondary">@b.Label</span>
                            <span class="fw-semibold">@b.Count</span>
                        </span>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row mb-4 g-2">
        <div class="col-md-8">
            <input type="text" id="boardSearch" class="form-control form-control-lg border-2"
                   placeholder="Wyszukaj tablicę po nazwie..." onkeyup="filterBoards()">
        </div>
        <div class="col-md-4 text-md-end">
            <button class="btn btn-lg text-white w-100 w-md-auto" style="background: linear-gradient(to right, #008080 0%, #000000 100%);"
                    data-bs-toggle="modal" data-bs-target="#createBoardModal">
                <i class="bi bi-plus-circle me-2"></i>Nowa tablica
            </button>
        </div>
    </div>

    <div id="boardList">
        @foreach (var board in Model.Boards)
        {
            <a asp-controller="Board" asp-action="Index" asp-route-id="@board.Id"
               class="card mb-3 shadow-sm border-0 board-item text-decoration-none">
                <div class="card-header pt-3 pb-3 board-header d-flex justify-content-between align-items-center"
                     style="background: linear-gradient(to right, @board.Theme.HeaderFrom 0%, @board.Theme.HeaderTo 100%);">
                    <div>
                        <h5 class="fw-bold mb-0 board-name">
                            <i class="bi bi-kanban-fill me-2"></i>@board.Name
                        </h5>
                        <small class="text-white-50">
                            @if (board.OwnerId == CurrentUser.UserId)
                            {
                                <span>Twoja tablica</span>
                            }
                            else
                            {
                                <span>Udostępniona przez @board.OwnerName</span>
                            }
                        </small>
                    </div>
                    <i class="bi bi-arrow-right"></i>
                </div>
            </a>
        }
        @if (!Model.Boards.Any())
        {
            <p class="text-muted">Nie masz jeszcze żadnej tablicy. Utwórz pierwszą przyciskiem „Nowa tablica".</p>
        }
    </div>
</div>

<div class="modal fade" id="createBoardModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-controller="Board" asp-action="CreateBoard" method="post" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nowa tablica</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label for="boardName" class="form-label">Nazwa tablicy</label>
                <input type="text" name="boardName" id="boardName" class="form-control" maxlength="80" required autofocus>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anuluj</button>
                <button type="submit" class="btn text-white" style="background: linear-gradient(to right, #008080 0%, #000000 100%);">Utwórz</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function filterBoards() {
            var input = document.getElementById('boardSearch').value.toLowerCase();
            var boards = document.querySelectorAll('.board-item');

            boards.forEach(function(board) {
                var name = board.querySelector('.board-name').innerText.toLowerCase();
                board.style.display = name.includes(input) ? "" : "none";
            });
        }

        (function () {
            var tooltip = document.createElement('div');
            tooltip.className = 'viz-tooltip';
            tooltip.hidden = true;
            document.body.appendChild(tooltip);

            function showTooltip(el) {
                var value = document.createElement('strong');
                value.textContent = el.dataset.count;
                var label = document.createTextNode(' ' + el.dataset.label);
                tooltip.replaceChildren(value, label);
                tooltip.hidden = false;

                var rect = el.getBoundingClientRect();
                tooltip.style.left = (rect.left + rect.width / 2 - tooltip.offsetWidth / 2) + 'px';
                tooltip.style.top = (rect.top - tooltip.offsetHeight - 8) + 'px';
            }

            function hideTooltip() {
                tooltip.hidden = true;
            }

            document.querySelectorAll('.js-viz-seg').forEach(function (seg) {
                seg.addEventListener('pointerenter', function () { showTooltip(seg); });
                seg.addEventListener('pointermove', function () { showTooltip(seg); });
                seg.addEventListener('pointerleave', hideTooltip);
                seg.addEventListener('focus', function () { showTooltip(seg); });
                seg.addEventListener('blur', hideTooltip);
            });
        })();
    </script>
}