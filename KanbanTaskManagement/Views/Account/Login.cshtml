@model KanbanTaskManagement.ViewModels.LoginInput
@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logowanie - KanbanTaskManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-background {
            background: linear-gradient(to bottom, #000000 0%, #001a1a 70%, #00adb5 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

            .login-background::after {
                content: '';
                position: absolute;
                bottom: -50px;
                width: 60%;
                height: 100px;
                background: #00adb5;
                filter: blur(80px);
                opacity: 0.3;
                z-index: 0;
            }

        .login-card {
            position: relative;
            z-index: 1;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(0, 173, 181, 0.3);
            border-radius: 15px;
            padding: 40px;
            width: 100%;
            max-width: 400px;
            color: white;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
        }

        .form-control {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
        }

            .form-control:focus {
                background: rgba(255, 255, 255, 0.2);
                color: white;
                border-color: #00adb5;
                box-shadow: 0 0 0 0.25rem rgba(0, 173, 181, 0.25);
            }

            .form-control::placeholder {
                color: rgba(255, 255, 255, 0.5);
            }

        .btn-login {
            background-color: #00adb5;
            border: none;
            color: white;
            font-weight: bold;
            transition: 0.3s;
        }

            .btn-login:hover {
                background-color: #007e85;
                transform: translateY(-2px);
            }

        .login-icon {
            font-size: 4rem;
            color: #00adb5;
            margin-bottom: 20px;
            display: block;
        }

        .field-validation-error, .text-danger { color: #ff9a9a !important; }
        .validation-summary-errors ul { margin: 0; padding-left: 1.1rem; }
    </style>
</head>
<body>

    <div class="login-background">
        <div class="login-card text-center">
            <i class="bi bi-kanban login-icon"></i>
            <h2 class="mb-4 fw-bold">KanbanTask</h2>

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors small mb-3 text-start"></div>

                <div class="mb-3 text-start">
                    <label asp-for="Username" class="form-label small text-uppercase"></label>
                    <input asp-for="Username" class="form-control form-control-lg" placeholder="Twój login" autofocus autocomplete="username">
                    <span asp-validation-for="Username" class="small"></span>
                </div>

                <div class="mb-3 text-start">
                    <label asp-for="Password" class="form-label small text-uppercase"></label>
                    <input asp-for="Password" class="form-control form-control-lg" placeholder="••••••••" autocomplete="current-password">
                    <span asp-validation-for="Password" class="small"></span>
                </div>

                <div class="form-check text-start mb-4">
                    <input asp-for="RememberMe" class="form-check-input">
                    <label asp-for="RememberMe" class="form-check-label small"></label>
                </div>

                <button type="submit" class="btn btn-login btn-lg w-100 mb-3">WEJDŹ</button>

                <div class="mt-3">
                    <small class="text-white-50">
                        Nie masz konta?
                        <a asp-controller="Account" asp-action="Register" class="text-white fw-bold text-decoration-none">Zarejestruj się</a>
                    </small>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
